---
import { getCollection } from 'astro:content';
import DownloadCard from '../components/DownloadCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { toDownloadItem } from '../lib/releases';

const notes = (await getCollection('releaseNotes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const allItems = notes.map(toDownloadItem).filter(Boolean) as NonNullable<ReturnType<typeof toDownloadItem>>[];
const latestStable = allItems.find((item) => item.category === 'stable-release');
const recentVersions = allItems.slice(0, 6);

const formatDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<SiteLayout frontmatter={{ title: '下载 OpenDesk', description: '下载 OpenDesk 稳定版和每日构建' }}>
  <section class="content-page download-page">
    <div class="download-page__grid">
      <div class="download-page__content">
        {
          latestStable ? (
            <DownloadCard item={latestStable} variant="stable" />
          ) : (
            <article class="download-card">
              <h2 class="download-card__version">暂无可用版本</h2>
              <p class="download-card__summary">当前还没有可下载的版本。</p>
              <footer class="download-card__links">
                <a href="/news/">查看历史版本</a>
              </footer>
            </article>
          )
        }
      </div>
      <aside class="download-page__sidebar">
        <h2 class="download-sidebar__title">最近发布的版本</h2>
        <ul class="download-version-list">
          {recentVersions.map((item) => (
            <li class="download-version-item">
              <a href={item.noteUrl} class="download-version-link">
                <span class="download-version-item__top">
                  <span class="download-version-item__version">{item.version}</span>
                  <span class={`download-version-item__badge${item.category === 'stable-release' ? ' download-version-item__badge--stable' : ' download-version-item__badge--nightly'}`}>
                    {item.category === 'stable-release' ? '稳定版' : '日构建'}
                  </span>
                  <span class="download-version-item__date">{formatDate.format(item.date)}</span>
                </span>
                <span class="download-version-item__summary">{item.summary}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="download-sidebar__more" href="/news/">查看所有历史版本 →</a>
      </aside>
    </div>
  </section>
</SiteLayout>
