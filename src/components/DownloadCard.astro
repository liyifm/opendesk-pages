---
import type { CpuArch } from '../lib/device';
import type { DownloadAsset, DownloadItem, DownloadOs } from '../lib/releases';
import PlatformIcon from './PlatformIcon.astro';

interface Props {
  item?: DownloadItem;
  variant: 'stable' | 'nightly';
  compact?: boolean;
}

const { item, variant, compact = false } = Astro.props;
const isNightly = variant === 'nightly';

const formatDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const isHapFile = (url: string) => /\.hap(\?|$)/i.test(url);

const isExternalLink = (os: DownloadOs, url: string) => os === 'harmonyos' && !isHapFile(url);

/** 平台名已经在标题里，每个安装包只标架构 */
const archLabels: Record<DownloadOs, Partial<Record<CpuArch, string>>> = {
  windows: { x86: 'x86（64 位）', arm64: 'ARM64' },
  macos: { arm64: 'Apple 芯片', x86: 'Intel 芯片' },
  harmonyos: {},
};

interface PlatformRow {
  label: string;
  url: string;
  external: boolean;
  /** 文件后缀徽标，应用市场链接显示来源 */
  badge: string;
  version: string;
}

interface PlatformBlock {
  os: DownloadOs;
  name: string;
  rows: PlatformRow[];
}

const assetExt = (url: string) => url.split('?')[0]?.match(/\.[a-z0-9]+$/i)?.[0] ?? '';

const buildBlock = (
  os: DownloadOs,
  name: string,
  assets: DownloadAsset[],
  version: string,
): PlatformBlock => ({
  os,
  name,
  rows: assets.map((asset) => {
    const external = isExternalLink(os, asset.url);
    return {
      label:
        (asset.arch && archLabels[os][asset.arch]) || (external ? '应用市场安装' : asset.label),
      url: asset.url,
      external,
      badge: external ? '' : assetExt(asset.url),
      version,
    };
  }),
});

// 日构建的版本号是 0.2.0-nightly-YYYYMMDD 这类长串，且正文里的日期容易被误判为版本号，只在稳定版展示
const rowVersion = (item: DownloadItem) => (item.category === 'stable-release' ? `v${item.version}` : '');

const blocks: PlatformBlock[] = item
  ? [
      buildBlock('windows', 'Windows 安装包下载', item.windows, rowVersion(item)),
      buildBlock('macos', 'macOS 安装包下载', item.macos, rowVersion(item)),
      buildBlock('harmonyos', 'HarmonyOS 安装链接', item.harmonyos, rowVersion(item)),
    ].filter((block) => block.rows.length > 0)
  : [];
---

{
  item ? (
    <article class:list={[!compact && 'download-card']}>
      {!compact && (
        <header class="download-card__header">
          <div>
            <h2 class="download-card__version">OpenDesk {item.version}</h2>
            <p class="download-card__date">{formatDate.format(item.date)}发布</p>
          </div>
          <span class="download-card__badge download-card__badge--stable">
            {isNightly ? '每日构建' : '稳定版'}
          </span>
        </header>
      )}

      {!compact && <p class="download-card__summary">{item.summary}</p>}

      {item.cli && (
        <div class="download-cli">
          <div>
            <span class="download-cli__label">Cli 命令行工具</span>
            <code class="download-cli__command">{item.cli}</code>
          </div>
          <button
            class="download-cli__copy"
            type="button"
            data-copy-text={item.cli}
          >
            复制
          </button>
        </div>
      )}

      {blocks.length > 0 && (
        <div class="download-platforms">
          {blocks.map((block) => (
            <section class="download-platform">
              <h3 class="download-platform__name">
                <PlatformIcon os={block.os} />
                <span>{block.name}</span>
              </h3>
              <div class="download-platform__list">
                {block.rows.map((row) => (
                  <a
                    class="download-item"
                    href={row.url}
                    download={row.external ? undefined : ''}
                  >
                    <span class="download-item__label">{row.label}</span>
                    {row.badge && <span class="download-item__badge">{row.badge}</span>}
                    {row.version && <span class="download-item__version">{row.version}</span>}
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      )}

      {item.harmonyos.some((asset) => isHapFile(asset.url)) && (
        <p class="download-signing-note">
          HarmonyOS 安装提示：下载 <code>.hap</code> 后，需要通过{' '}
          <a href="https://developer.huawei.com/consumer/cn/deveco-studio/" target="_blank" rel="noreferrer">
            DevEco Studio
          </a>{' '}
          或{' '}
          <a href="https://github.com/likuai2010/auto-installer/" target="_blank" rel="noreferrer">
            Auto-installer
          </a>{' '}
          手动签名后安装。
        </p>
      )}

      {!compact && (
        <footer class="download-card__links">
          <a href={item.noteUrl}>查看版本说明 →</a>
        </footer>
      )}
    </article>
  ) : (
    <article class="download-card">
      <h2 class="download-card__version">暂无可用版本</h2>
      <p class="download-card__summary">当前分类还没有可下载的版本。</p>
      <footer class="download-card__links">
        <a href="/news/">查看历史版本</a>
      </footer>
    </article>
  )
}

<script>
  const writeClipboardText = async (text: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.append(textarea);
    textarea.select();
    document.execCommand('copy');
    textarea.remove();
  };

  const setupCopyButtons = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-text]').forEach((button) => {
      if (button.dataset.copyReady === 'true') return;
      button.dataset.copyReady = 'true';

      button.addEventListener('click', async () => {
        const text = button.dataset.copyText;
        if (!text) return;

        const originalLabel = button.textContent ?? '复制';
        try {
          await writeClipboardText(text);
          button.textContent = '已复制';
        } catch {
          button.textContent = '复制失败';
        }

        window.setTimeout(() => {
          button.textContent = originalLabel;
        }, 2000);
      });
    });
  };

  setupCopyButtons();
  document.addEventListener('astro:page-load', setupCopyButtons);
</script>
