---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import homepage from '../../assets/images/quickstart/homepage.jpg';
import homepageDark from '../../assets/images/quickstart/homepage_dark.jpg';
import type { DownloadAsset } from '../../lib/releases';
import { toDownloadItem } from '../../lib/releases';

const notes = await getCollection('releaseNotes');
const sorted = notes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestStable = sorted.find((n) => n.data.category === 'stable-release');
const latest = toDownloadItem(latestStable);
const version = latest?.version ?? '';
const latestNoteUrl = latest?.noteUrl ?? '/news/';

const toTargets = (assets: DownloadAsset[] = []) => assets.map(({ url, arch }) => ({ url, arch }));
const downloadTargets = JSON.stringify({
  windows: toTargets(latest?.windows),
  macos: toTargets(latest?.macos),
  harmonyos: toTargets(latest?.harmonyos),
});
---

<section class="home-hero">
  <div class="home-hero__inner">
    <div class="home-hero__badge">编程 / 轻办公一站式生产力智能体</div>
    <h1>OpenDesk</h1>
    <p class="home-hero__sub">
      把模型、MCP、Skills 和消息渠道连接成一个可长期运行的桌面智能体。让它整理文件、连接飞书微信、执行开发任务，并把结果送回你手边。
    </p>
    <div class="home-hero__actions">
      <a
        class="home-cta"
        href="/download/"
        data-download-btn
        data-download-targets={downloadTargets}
        data-fallback="/download/"
        data-version={version}
      >
        <span class="home-cta__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </span>
        <span class="home-cta__text">
          <span class="home-cta__label">下载桌面端</span>
          <span class="home-cta__hint" data-download-hint>(自动识别对应平台)</span>
        </span>
      </a>
      <div class="home-hero__links">
        <a href={latestNoteUrl}>
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
          版本介绍
        </a>
        <span aria-hidden="true">·</span>
        <a href="/download/">
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          查看全部下载
        </a>
        <span aria-hidden="true">·</span>
        <a href="/docs/quickstart/desktop/">
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
            <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
            <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
            <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
          </svg>
          快速开始
        </a>
      </div>
      <p class="home-hero__cli">
        偏爱<a href="/docs/manual/cli/">命令行</a>？<code>npm i -g @bitclub.ai/opendesk-cli</code>
      </p>
    </div>
    <div class="home-hero__visual" aria-label="OpenDesk 产品界面预览">
      <div class="home-window">
        <Image class="home-window__img home-window__img--light" src={homepage} alt="OpenDesk 桌面界面" />
        <Image class="home-window__img home-window__img--dark" src={homepageDark} alt="OpenDesk 桌面界面" />
      </div>
    </div>
  </div>
</section>

<script>
  import { detectDevice, fallbackArch, selectAsset } from '../../lib/device';
  import type { CpuArch, DeviceOs } from '../../lib/device';

  interface DownloadTarget {
    url: string;
    arch?: CpuArch;
  }

  const deviceLabel = (os: DeviceOs, arch?: CpuArch) => {
    if (os === 'harmonyos') return 'HarmonyOS';
    if (os === 'macos') {
      if (arch === 'arm64') return 'macOS (Apple 芯片)';
      if (arch === 'x86') return 'macOS (Intel 芯片)';
      return 'macOS';
    }
    if (arch === 'arm64') return 'Windows ARM64';
    if (arch === 'x86') return 'Windows x86';
    return 'Windows';
  };

  const setupDownloadButton = async () => {
    const btn = document.querySelector<HTMLAnchorElement>('[data-download-btn]');
    const hint = document.querySelector('[data-download-hint]');
    if (!btn) return;

    const targets = JSON.parse(btn.dataset.downloadTargets ?? '{}') as Record<string, DownloadTarget[]>;
    const ver = btn.dataset.version ? ` · v${btn.dataset.version}` : '';

    const device = await detectDevice();
    const asset = selectAsset(targets[device.os] ?? [], device.arch ?? fallbackArch(device.os));

    if (!asset) {
      if (ver && hint) hint.textContent = `最新稳定版${ver}`;
      return;
    }

    btn.href = asset.url;
    if (device.os !== 'harmonyos') btn.setAttribute('download', '');
    if (hint) hint.textContent = `适用于 ${deviceLabel(device.os, asset.arch)}${ver}`;
  };

  setupDownloadButton();
  document.addEventListener('astro:page-load', setupDownloadButton);
</script>
