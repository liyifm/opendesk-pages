---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import homepage from '../../assets/images/quickstart/homepage.jpg';
import homepageDark from '../../assets/images/quickstart/homepage_dark.jpg';

const notes = await getCollection('releaseNotes');
const sorted = notes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestStable = sorted.find((n) => n.data.category === 'stable-release');
const downloads = latestStable?.data.downloads;
const version = latestStable?.data.version ?? '';
const windowsUrl = downloads?.windows?.url ?? '';
const macosUrl = downloads?.macos?.url ?? '';
const harmonyosUrl = downloads?.harmonyos?.url ?? '';
---

<section class="home-hero">
  <div class="home-hero__inner">
    <div class="home-hero__badge">编程 / 轻办公一站式生产力智能体</div>
    <h1>OpenDesk</h1>
    <p class="home-hero__sub">
      把模型、MCP、Skills 和消息渠道连接成一个可长期运行的桌面智能体。让它整理文件、连接飞书微信、执行开发任务，并把结果送回你手边。
    </p>
    <div class="home-hero__actions">
      <a
        class="home-cta"
        href="/download"
        data-download-btn
        data-windows={windowsUrl}
        data-macos={macosUrl}
        data-harmonyos={harmonyosUrl}
        data-fallback="/download"
        data-version={version}
      >
        <span class="home-cta__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </span>
        <span class="home-cta__text">
          <span class="home-cta__label">下载桌面端</span>
          <span class="home-cta__hint" data-download-hint>(自动识别对应平台)</span>
        </span>
      </a>
      <div class="home-hero__links">
        <a href="/download">
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          查看全部下载
        </a>
        <span aria-hidden="true">·</span>
        <a href="/docs/quickstart/desktop/">
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
            <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
            <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
            <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
          </svg>
          快速开始
        </a>
      </div>
      <p class="home-hero__cli">
        偏爱<a href="/docs/manual/cli/">命令行</a>？<code>npm i -g @bitclub.ai/opendesk-cli</code>
      </p>
    </div>
    <div class="home-hero__visual" aria-label="OpenDesk 产品界面预览">
      <div class="home-window">
        <Image class="home-window__img home-window__img--light" src={homepage} alt="OpenDesk 桌面界面" />
        <Image class="home-window__img home-window__img--dark" src={homepageDark} alt="OpenDesk 桌面界面" />
      </div>
    </div>
  </div>
</section>

<script>
  // OS detection
  const btn = document.querySelector('[data-download-btn]');
  const hint = document.querySelector('[data-download-hint]');
  if (btn) {
    const ua = navigator.userAgent;
    const platform = navigator.platform ?? '';

    // HarmonyOS first: HarmonyOS browsers may expose a Windows-like UA
    // (e.g. "Win64") or a Linux platform, so check both UA and platform
    // before windows/mac to avoid misrouting.
    const isHarmony = /harmony\s?os|ohos|openharmony/i.test(`${ua} ${platform}`);
    const isWindows = /windows|win32|win64/i.test(platform) || /windows/i.test(ua);
    const isMac = /macintosh|macintel|macppc|mac68k|darwin/i.test(platform) || /mac os x/i.test(ua);

    let url = '';
    let label = '';
    let isExternal = false;
    if (isHarmony && btn.dataset.harmonyos) {
      url = btn.dataset.harmonyos;
      label = 'HarmonyOS';
      isExternal = true;
    } else if (isWindows && btn.dataset.windows) {
      url = btn.dataset.windows;
      label = 'Windows';
    } else if (isMac && btn.dataset.macos) {
      url = btn.dataset.macos;
      label = 'macOS';
    }

    const ver = btn.dataset.version ? ` · v${btn.dataset.version}` : '';

    if (url) {
      btn.href = url;
      if (!isExternal) btn.setAttribute('download', '');
      if (hint) hint.textContent = `适用于 ${label}${ver}`;
    } else if (ver && hint) {
      hint.textContent = `最新稳定版${ver}`;
    }
  }
</script>
