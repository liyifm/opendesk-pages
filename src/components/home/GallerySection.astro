---
import { Image } from 'astro:assets';
import fileOrganize from '../../assets/images/gallery/file_organize.jpg';
import fileTransfer from '../../assets/images/gallery/file_transfer.jpg';

const cases = [
  {
    title: '文件整理',
    body: '归档混乱目录、清理重复文件、重命名素材，让桌面从任务堆变回工作台。',
    image: fileOrganize,
    alt: '文件整理场景',
  },
  {
    title: '远程文件查找',
    body: '在路上给 OpenDesk 发消息，让它从电脑里找到文件并回传。',
    image: fileTransfer,
    alt: '远程文件查找场景',
  },
];
---

<section id="gallery" class="home-gallery-band">
  <div class="home-gallery__inner">
    <div class="home-section__header home-gallery__head">
      <h2><span class="title-line">为繁琐任务保留一个</span><span class="title-line">可靠的执行者</span></h2>
      <p>文件整理、远程查找、资料收集……把这些重复劳动交给 OpenDesk，你只需要验收结果。</p>
    </div>
    <div class="home-gallery__grid">
      {
        cases.map((item) => (
          <article class="home-case">
            <Image src={item.image} alt={item.alt} />
            <div class="home-case__caption">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
