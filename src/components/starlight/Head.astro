---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';
---

<script is:inline>
(function() {
  if (location.hostname === 'opendesk.bitclub.ai') {
    location.replace('https://opendesk.matrix.openharmony.cn' + location.pathname + location.search + location.hash);
  }
})();
</script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.1/css/all.min.css" />
<DefaultHead {...Astro.props} />
<ClientRouter />

{/*
  Starlight's sidebar scroll restore lives in inline scripts that Astro dedupes and does NOT
  re-execute across view-transition navigations, so the menu jumps back to the top on every
  click. Implement a self-contained save/restore using our own storage key: capture the
  `#starlight__sidebar` scrollTop before the swap, and re-apply it after the new page is in
  place. Listeners are registered once and persist on `document` for the whole session.
*/}
<script>
  const SIDEBAR_SCROLL_KEY = 'opendesk-sidebar-scroll';
  const getScroller = () => document.getElementById('starlight__sidebar');

  const saveSidebarScroll = () => {
    const scroller = getScroller();
    if (!scroller) return;
    try {
      sessionStorage.setItem(SIDEBAR_SCROLL_KEY, String(scroller.scrollTop));
    } catch {}
  };

  const restoreSidebarScroll = () => {
    const scroller = getScroller();
    if (!scroller) return;
    let scroll = 0;
    try {
      scroll = parseInt(sessionStorage.getItem(SIDEBAR_SCROLL_KEY) || '0', 10) || 0;
    } catch {}
    // Wait one frame so the new sidebar is laid out before applying scrollTop.
    requestAnimationFrame(() => {
      scroller.scrollTop = scroll;
    });
  };

  if (!window.__opendeskSidebarScrollPatched) {
    window.__opendeskSidebarScrollPatched = true;
    document.addEventListener('astro:before-swap', saveSidebarScroll);
    document.addEventListener('astro:after-swap', restoreSidebarScroll);
    document.addEventListener('astro:page-load', restoreSidebarScroll);
    // Also cover full page navigations / tab switches.
    addEventListener('pagehide', saveSidebarScroll);
    addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') saveSidebarScroll();
    });
  }
</script>

<script is:inline>
(function() {
  function initImageLightbox() {
    // 移除已有的 overlay
    const existing = document.getElementById('image-lightbox-overlay');
    if (existing) existing.remove();

    // 为所有文档内图片添加点击事件
    document.querySelectorAll('.sl-markdown-content img').forEach(img => {
      if (img.dataset.lightbox === 'true') return;
      img.dataset.lightbox = 'true';
      img.addEventListener('click', (e) => {
        e.stopPropagation();
        showLightbox(img.src);
      });
    });
  }

  function showLightbox(src) {
    const overlay = document.createElement('div');
    overlay.id = 'image-lightbox-overlay';
    overlay.className = 'image-lightbox-overlay';
    overlay.innerHTML = '<img src="' + src + '" alt="预览大图" />';
    document.body.appendChild(overlay);

    // 触发显示动画
    requestAnimationFrame(() => overlay.classList.add('active'));

    // 点击 overlay 区域关闭（点击图片本身不关闭）
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) hideLightbox(overlay);
    });

    // 按 ESC 关闭
    const escHandler = (e) => {
      if (e.key === 'Escape') {
        hideLightbox(overlay);
        document.removeEventListener('keydown', escHandler);
      }
    };
    document.addEventListener('keydown', escHandler);
  }

  function hideLightbox(overlay) {
    overlay.classList.remove('active');
    overlay.addEventListener('transitionend', () => overlay.remove(), { once: true });
    // 防止 transitionend 不触发的兜底
    setTimeout(() => { if (overlay.parentNode) overlay.remove(); }, 300);
  }

  // 初始加载
  document.addEventListener('DOMContentLoaded', function() {
    initImageLightbox();
    moveFooter();
  });

  // SPA 页面切换后重新绑定
  document.addEventListener('astro:after-swap', function() {
    initImageLightbox();
    moveFooter();
  });

  function moveFooter() {
    var footer = document.querySelector('.opendesk-sl-footer');
    if (!footer) return;
    var page = document.querySelector('.page');
    if (!page || footer.parentElement === page) return;
    footer.classList.add('opendesk-sl-footer--moved');
    page.appendChild(footer);
  }
})();
</script>
