---
/** 下载卡片中平台小标题前的图标 */
interface Props {
  os: 'windows' | 'macos' | 'harmonyos';
}

const { os } = Astro.props;
---

<span class="platform-icon" aria-hidden="true">
  {
    os === 'windows' && (
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M0 3.449 9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801" />
      </svg>
    )
  }
  {
    os === 'macos' && (
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
      </svg>
    )
  }
  {
    os === 'harmonyos' && (
      <svg viewBox="0 0 32 32" fill="none">
        <defs>
          <linearGradient id="platform-icon-harmonyos" x1="4" y1="4" x2="28" y2="28" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#2f7df6" />
            <stop offset="1" stop-color="#3fc37e" />
          </linearGradient>
        </defs>
        <path
          d="M19.46 11.12a8.5 8.5 0 1 0 0 9.76"
          stroke="url(#platform-icon-harmonyos)"
          stroke-width="4.2"
          stroke-linecap="round"
        />
        <g fill="url(#platform-icon-harmonyos)">
          <path d="M22.2 8.8h2.8l-1.1 3.4h-2.8z" />
          <path d="M26.6 8.8H30l-1.1 3.4h-3.4z" />
          <g transform="translate(0.4 5.2)">
            <path d="M22.2 8.8h2.8l-1.1 3.4h-2.8z" />
            <path d="M26.6 8.8H30l-1.1 3.4h-3.4z" />
          </g>
          <g transform="translate(0 10.4)">
            <path d="M22.2 8.8h2.8l-1.1 3.4h-2.8z" />
            <path d="M26.6 8.8H30l-1.1 3.4h-3.4z" />
          </g>
        </g>
      </svg>
    )
  }
</span>

<style>
  .platform-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
  }

  .platform-icon svg {
    width: 100%;
    height: 100%;
  }
</style>
